{
  "uid": "slate-web-vitals",
  "title": "Slate \u2014 Web Vitals",
  "description": "Local browser Web Vitals debugging dashboard. Source: src/observability/browser.ts. Reported updates, not per-visit p75 scores.",
  "tags": [
    "slate",
    "web-vitals",
    "local"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Slate Web Vitals \u00b7 local development",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Local browser measurements for `service.name=slate`.** Cards average reported values over the selected time range; trends show rolling averages. LCP / INP / CLS are Core Web Vitals; FCP / TTFB are supporting metrics.\n\nRepeated updates are included (`reportAllChanges`), so these are **not per-visit p75 scores or a pass rate**. Vite, HMR and diagnostic-page activity can affect results. Interact with Slate and switch tabs to report INP and final updates. [Threshold reference](https://web.dev/articles/vitals)."
      }
    },
    {
      "id": 2,
      "title": "LCP \u00b7 average reported value",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Largest Contentful Paint. Mean of all reported updates within the selected time range, including repeated updates for the same vital ID. Threshold colors are reference guides, not an aggregate pass/fail assessment.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "avg_over_time({service_name=\"slate\"} | vital_name=\"LCP\" | unwrap vital_value | __error__=\"\" [$__range]) by ()",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2500
              },
              {
                "color": "red",
                "value": 4000
              }
            ]
          },
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
