    {
      "id": 12,
      "title": "Reported updates by metric and rating",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (vital_name, vital_rating) (count_over_time({service_name=\"slate\"} | vital_name!=\"\" [$__range]))",
          "legendFormat": "{{vital_name}} \u00b7 {{vital_rating}}",
          "queryType": "instant"
        }
      ],
      "description": "Counts reported updates, not unique visits. Repeated updates may have different ratings. Includes local diagnostic-page activity.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "vital_name": 0,
              "vital_rating": 1,
              "Value #A": 2
            },
            "renameByName": {
              "vital_name": "Metric",
              "vital_rating": "Rating",
              "Value #A": "Reports"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "title": "Recent Web Vitals \u00b7 value, rating and URL",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"slate\"} | vital_name!=\"\" | line_format \"{{.vital_name}} = {{.vital_value}} \u00b7 {{.vital_rating}} \u00b7 {{.url_full}} \u00b7 id={{.vital_id}}\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
